// A subscript that only the setter is declared for has nothing to fall back on when read.
// EXPECT_ERROR overloads <__setitem__> but not <__getitem__>
struct Table
    base: int
    function __setitem__(self, i: int, value: int)
        self.base := value
    end function
end struct
on init
    declare t := Table(10)
    message(t[1])
end on
