// EXPECT     if\(\$value = 1\)
// EXPECT     else
// EXPECT     message\("if fallback"\)
// EXPECT     case -2147483648 to 134217727
// EXPECT     message\("select fallback"\)

on init
    declare value
    select value
        case 1
            if value = 1
                message("if branch")
            else
                message("if fallback")
            end if
        else
            message("select fallback")
    end select
end on
