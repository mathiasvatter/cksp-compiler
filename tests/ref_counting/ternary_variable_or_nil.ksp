// A ternary that borrows a variable's reference retains it just like one that borrows a call's
// result (#144).
// EXPECT (call Item______incr__|%Item____allocation\[\$[a-z_]+[0-9]*\] := %Item____allocation\[\$[a-z_]+[0-9]*\] \+)

struct Item
	v: int
end struct

declare items[4]: Item[]

function find(v: int): Item
	for i in range(4)
		if items[i] # nil and items[i].v = v
			return items[i]
		end if
	end for
	return nil
end function

on note
	declare it: Item := EVENT_VELOCITY > 0 ? items[0] : nil
	message(it?.v ?? -1)
end on
