// A pointer assigned from a ternary whose other branch is nil retains the borrowed reference
// after releasing the old one (#144).
// EXPECT (call Item______incr__|%Item____allocation\[\$[a-z_]+[0-9]*\] := %Item____allocation\[\$[a-z_]+[0-9]*\] \+)

struct Item
	v: int
end struct

declare items[4]: Item[]

function find(v: int): Item
	for i in range(4)
		if items[i] # nil and items[i].v = v
			return items[i]
		end if
	end for
	return nil
end function

on note
	declare it: Item
	it := EVENT_VELOCITY > 0 ? find(EVENT_NOTE) : nil
	message(it?.v ?? -1)
end on
