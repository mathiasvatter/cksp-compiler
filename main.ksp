#pragma output_path("test.txt")
#pragma combine_callbacks(true)
#pragma max_callback_depth(420)


struct Instrument
    static const bubu: int := 4500
    next: Group
    zones[1000000]: Zone[]    

    // function find_zone(self)
    //     return search(self.zones.id, 5)
    // end function        
end struct    
  
struct Zone
    static const StartType
        Beginning, Middle, End
    end const
    static const pupsen := 30
    idx: int
    id: int
    file: string
    startMod: int

    function add(self)
        message(self.StartType)
        message(Zone.pupsen)
    end function        
end struct    

declare Instrument := new Instrument(nil, [nil])
on note
    message(Instrument.zones[0].StartType.Beginning)
    message(Instrument.bubu)
    declare arr[Instrument.bubu]
    message(arr[0])
end on
