struct Volume
    group_idx: int
    slot_idx: int

    function __set__(self, volume)
        set_engine_par($EVENT_PAR_VOLUME, volume, self.group_idx, self.slot_idx, -1)
    end function    

    function __get__(self)
        return get_engine_par($EVENT_PAR_VOLUME, self.group_idx, self.slot_idx, -1)
    end function        
end struct    

struct List
    value: string
    next: List
end struct

struct List<T>
    static const pipi := 5
    value: T
    next: List<T>
end struct

