struct Foo
    grid[2,2]: int[][] := [[3,4], [3,5]]
    y: int

    function __init__(self, i: int)
        self.y := i
    end function

    function fill(self)
        self.grid := [[1,2],[3,4]]
    end function
end struct

on init
    declare a: Foo := new Foo(1)
    a.fill()
    message(a.grid[1,1])
end on