#pragma output_path("test.txt")
#pragma combine_callbacks(true)
// #pragma max_callback_depth(420)

struct Box<T>
	value: T
	function __init__(self)
		self.value := nil
	end function
end struct

declare box := new Box<Item>()

struct Item
	x: int
end struct

on init
	message(box.value?.x ?? 0)

	if not 1
		message("sdflkj")
	end if		
end on